#!/usr/bin/env bash

# c-basic-offset: 4; tab-width: 4; indent-tabs-mode: t
# vi: set shiftwidth=4 tabstop=4 noexpandtab:
# :indentSize=4:tabSize=4:noTabs=false:

# http://redsymbol.net/articles/unofficial-bash-strict-mode/
set -o nounset
set -o errexit
set -o pipefail

###############################################################################

# wipe-removable
# - Accepts "sdc" or "/dev/sdc"
# - If no argument: lists block devices (fixed + removable for reference),
#   but only allows selecting REMOVABLE ones (USB sticks, SD card readers, etc.)
#
# Usage:
#   ./wipe-removable            # interactive (removable only)
#   ./wipe-removable sdc        # direct
#   ./wipe-removable /dev/sdc   # direct
#
# Requires jq for checked device/mount inventories. Unmounts synchronously and
# disables swap, then rechecks both before any wipe. Any discovery/unmount/swap
# failure aborts. Checks cover this mount namespace, not concurrent new users.

die() {
    echo "ERROR: $*" >&2
    exit 1
}

is_whole_disk_name() {
    local d="$1"
    # allow: sdX, vdX, xvdX, nvmeXnY, mmcblkN
    [[ "$d" =~ ^sd[a-z]+$ ]] || [[ "$d" =~ ^vd[a-z]+$ ]] || [[ "$d" =~ ^xvd[a-z]+$ ]] ||
        [[ "$d" =~ ^nvme[0-9]+n[0-9]+$ ]] || [[ "$d" =~ ^mmcblk[0-9]+$ ]]
}

normalize_dev() {
    local in="$1"
    # strip /dev/ if given
    in="${in#/dev/}"
    echo "$in"
}

sys_block_path() {
    local name="$1"
    echo "/sys/block/$name"
}

is_removable() {
    local name="$1"
    local p
    p="$(sys_block_path "$name")"
    [[ -r "$p/removable" ]] || return 1
    [[ "$(cat "$p/removable")" == "1" ]]
}

list_all_devices() {
    # Reference list (shows fixed + removable)
    # Exclude noisy pseudo devices
    lsblk -d -o NAME,MODEL,SIZE,ROTA,HOTPLUG,RM,TRAN,TYPE |
        awk 'NR==1 || ($1 !~ /^(loop|ram|zram|dm-|md)/ && $NF=="disk")'
}

list_removable_candidates() {
    # Candidates = disks with RM=1 or /sys/block/*/removable=1 (prefer sysfs)
    # Exclude loop/dm/md/etc
    lsblk -dn -o NAME,TYPE | awk '$2=="disk"{print $1}' |
        grep -Ev '^(loop|ram|zram|dm-|md)' |
        while read -r d; do
            if [[ -b "/dev/$d" ]] && is_removable "$d"; then
                echo "$d"
            fi
        done
}

pick_device_interactive() {
    echo "Block devices (reference):" >&2
    list_all_devices >&2
    echo >&2
    echo "Removable candidates (allowed targets):" >&2
    local cands=()
    while read -r d; do
        [[ -n "$d" ]] && cands+=("$d")
    done < <(list_removable_candidates)

    # Warn about removable devices with missing/corrupt /dev nodes
    while read -r d; do
        if [[ ! -b "/dev/$d" ]] && is_removable "$d"; then
            echo "  SKIPPED: /dev/$d exists but is not a block device ($(stat -c '%F' "/dev/$d" 2>/dev/null || echo 'missing'))" >&2
            echo "           Fix: sudo rm /dev/$d && sudo udevadm trigger --subsystem-match=block" >&2
        fi
    done < <(lsblk -dn -o NAME,TYPE | awk '$2=="disk"{print $1}' | grep -Ev '^(loop|ram|zram|dm-|md)')

    if [[ "${#cands[@]}" -eq 0 ]]; then
        die "No removable block devices detected."
    fi

    for d in "${cands[@]}"; do
        # show nice per-device line
        lsblk -d -o NAME,MODEL,SIZE,TRAN,RM,HOTPLUG "/dev/$d" | tail -n +2 | sed 's/^/  /' >&2
    done
    echo >&2
    read -r -p "Enter device NAME to wipe (e.g. sdc): " ans >&2
    ans="$(normalize_dev "$ans")"
    echo "$ans"
}

assert_safe_target() {
    local name="$1"
    is_whole_disk_name "$name" || die "Invalid device name '$name' (need whole disk like sdc, nvme0n1, mmcblk0)."

    if [[ ! -b "/dev/$name" ]]; then
        if [[ -e "/dev/$name" ]]; then
            die "/dev/$name exists but is not a block device ($(stat -c '%F' "/dev/$name")). Fix: sudo rm /dev/$name && sudo udevadm trigger --subsystem-match=block"
        else
            die "/dev/$name does not exist."
        fi
    fi

    # Do not allow partitions as input
    if [[ "$name" =~ ^sd[a-z]+[0-9]+$ ]] || [[ "$name" =~ ^nvme[0-9]+n[0-9]+p[0-9]+$ ]] || [[ "$name" =~ ^mmcblk[0-9]+p[0-9]+$ ]]; then
        die "Give the WHOLE disk (e.g. sdc), not a partition."
    fi

    # Hard gate: only removable devices are allowed
    is_removable "$name" || die "/dev/$name is NOT marked removable by the kernel. Refusing."
}

# Capture and validate inventories before using them. An empty/malformed or failed
# command must never look like "nothing mounted" through process substitution.
device_usage() {
    local dev=$1 devices mounts swap_list swap_name swap_id line mount_lines node_lines node
    devices=$(lsblk --json --paths --output NAME,MAJ:MIN "$dev") || die "Cannot enumerate $dev"
    DEVICE_IDS=$(jq -ce '
        [.blockdevices[] | recurse(.children[]?) | .["maj:min"]] |
        if length > 0 and all(.[]; type == "string" and test("^[0-9]+:[0-9]+$"))
        then unique else error("invalid device inventory") end
    ' <<<"$devices") || die "Invalid device inventory for $dev"
    node_lines=$(jq -c '
        [.blockdevices[] | recurse(.children[]?) | .name] |
        if length > 0 and all(.[]; type == "string" and startswith("/dev/"))
        then unique | .[] else error("invalid device paths") end
    ' <<<"$devices") || die "Invalid device paths for $dev"
    DEVICE_NODES=()
    while IFS= read -r line; do
        IFS= read -r -d '' node < <(jq -j '. + "\u0000"' <<<"$line") || die "Cannot decode device path"
        DEVICE_NODES+=("$node")
    done <<<"$node_lines"

    mounts=$(findmnt --json --list --output TARGET,MAJ:MIN) || die "Cannot enumerate mounts"
    mount_lines=$(jq -c --argjson ids "$DEVICE_IDS" '
        .filesystems |
        if type == "array" and all(.[];
            (.target | type == "string") and
            (.["maj:min"] | type == "string" and test("^[0-9]+:[0-9]+$")))
        then . else error("invalid mount inventory") end |
        [.[] | select(.["maj:min"] as $id | $ids | index($id)) | .target] |
        unique | sort_by(length) | reverse | .[]
    ' <<<"$mounts") || die "Invalid mount inventory"
    DEVICE_MOUNTS=()
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        # Each line is a JSON string. Decode with NUL framing to retain whitespace.
        IFS= read -r -d '' mount_point < <(jq -j '. + "\u0000"' <<<"$line") || die "Cannot decode mount point"
        DEVICE_MOUNTS+=("$mount_point")
    done <<<"$mount_lines"

    swap_list=$(swapon --show=NAME --noheadings --raw) || die "Cannot enumerate active swap"
    DEVICE_SWAPS=()
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        # util-linux raw output hex-escapes unsafe pathname characters.
        printf -v swap_name '%b' "$line"
        swap_id=$(swap_device_id "$swap_name") || die "Cannot identify swap device: $swap_name"
        [[ "$swap_id" =~ ^[0-9]+:[0-9]+$ ]] || die "Invalid swap device identity: $swap_name"
        if jq -e --arg id "$swap_id" 'index($id) != null' <<<"$DEVICE_IDS" >/dev/null; then
            DEVICE_SWAPS+=("$swap_name")
        else
            local rc=$?
            [[ $rc -eq 1 ]] || die "Cannot compare swap device identity"
        fi
    done <<<"$swap_list"
}

swap_device_id() {
    if [[ -b "$1" ]]; then
        lsblk --nodeps --noheadings --raw --output MAJ:MIN "$1"
    elif [[ -f "$1" ]]; then
        # Swap files belong to their containing filesystem, not a /dev pathname.
        findmnt --noheadings --raw --output MAJ:MIN --target "$1"
    else
        return 1
    fi
}

wipe_device() {
    local DEV="/dev/$1"
    local mp part
    local DEVICE_IDS mount_point
    local -a DEVICE_NODES=() DEVICE_MOUNTS=() DEVICE_SWAPS=()

    echo "Target: $DEV"
    lsblk -o NAME,MODEL,SIZE,TYPE,MOUNTPOINT,FSTYPE,UUID "$DEV"
    echo
    read -r -p "Type YES to WIPE $DEV permanently: " ans
    [[ "$ans" == "YES" ]] || die "Aborted."

    device_usage "$DEV"
    # Swap files must be disabled while their containing filesystem is mounted.
    echo "==> Disabling swap on $DEV (if any)..."
    for part in "${DEVICE_SWAPS[@]}"; do
        echo "  swapoff $part"
        swapoff -- "$part" || die "Cannot disable swap: $part"
    done

    echo "==> Unmounting anything on $DEV..."
    # Longer paths precede parents, covering nested mounts and bind mounts.
    for mp in "${DEVICE_MOUNTS[@]}"; do
        echo "  umount $mp"
        umount -- "$mp" || die "Cannot unmount: $mp"
    done

    echo "==> Flushing I/O..."
    sync
    blockdev --flushbufs "$DEV" || true

    echo "==> Settling udev + nudging kernel to drop stale partition state..."
    partprobe "$DEV" 2>/dev/null || true
    udevadm settle || true

    device_usage "$DEV"
    if (( ${#DEVICE_MOUNTS[@]} || ${#DEVICE_SWAPS[@]} )); then
        die "$DEV still has mounts or active swap; refusing to wipe"
    fi

    echo "==> Wiping signatures (disk + any visible partitions)..."
    wipefs -a "$DEV" || true
    for part in "${DEVICE_NODES[@]}"; do
        [[ "$part" == "$DEV" ]] && continue
        [[ -b "$part" ]] || continue
        wipefs -a "$part" || true
    done

    echo "==> Killing partition tables (GPT/MBR) with sgdisk if available..."
    if command -v sgdisk >/dev/null 2>&1; then
        sgdisk --zap-all "$DEV" || true
        sgdisk --clear "$DEV" >/dev/null 2>&1 || true
    else
        echo "  (sgdisk not found; using dd fallback only)"
    fi

    echo "==> Wiping first and last 16 MiB (bootloader areas, stray metadata)..."
    dd if=/dev/zero of="$DEV" bs=1M count=16 conv=fsync status=progress

    local sectors
    local tail_sectors
    local seek
    sectors=$(blockdev --getsz "$DEV") || die "blockdev --getsz failed"
    tail_sectors=32768 # 16MiB in 512B sectors
    if ((sectors > tail_sectors)); then
        seek=$((sectors - tail_sectors))
        dd if=/dev/zero of="$DEV" bs=512 seek="$seek" count="$tail_sectors" conv=fsync status=progress
    else
        echo "  Disk too small to wipe last 16MiB; skipping tail wipe."
    fi

    echo "==> Final sync + tell kernel to re-read partition table (flush host-side caches)..."
    sync
    blockdev --flushbufs "$DEV" || true
    partprobe "$DEV" 2>/dev/null || true
    blockdev --rereadpt "$DEV" 2>/dev/null || true
    udevadm settle || true

    echo "==> Result:"
    lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINT "$DEV"
    echo "Done."
}

main() {
    if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
        exec sudo "$(readlink -f "$0")" "$@"
    fi

    local arg="${1:-}"
    local name=""
    if [[ -z "$arg" ]]; then
        name="$(pick_device_interactive)"
    else
        name="$(normalize_dev "$arg")"
    fi

    assert_safe_target "$name"
    wipe_device "$name"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
