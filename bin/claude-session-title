#!/usr/bin/env bash
# Prefix the Claude Code session title with the checkout it belongs to, so a sway titlebar says
# WHICH repo is asking and not only what the task is:
#
#     ⠂ meta:fix/39-render-matrix-validate-input · Understand MR READY concept
#
# Wired to the SessionStart and UserPromptSubmit hooks in ~/.claude/settings.json; reads the hook
# JSON payload on stdin and prints hookSpecificOutput.sessionTitle. See ~/etc/docs/terminal.md.
#
# YIELD-THEN-TAKE-OVER (2026-08-02). Writing a title before Claude has named the session
# PERMANENTLY suppresses its own `ai-title` -- proven by an isolated four-run A/B under a
# throwaway CLAUDE_CONFIG_DIR (same prompt, same model, same repo, only the hook differing):
#
#     A  no hook                          -> {"type":"ai-title","aiTitle":"Understand git rebase operation"}
#     B  hook writes at SessionStart      -> no ai-title, ever
#     C  hook writes at first prompt      -> no ai-title, ever
#     D  hook writes only once one exists -> ai-title survives
#
# Confirmed in production: of 13 sessions since 2026-07-29 whose first title record is a
# custom-title, none ever received an ai-title. The old unconditional version therefore produced
# `repo:branch · repo:branch` forever, because from turn two it read its own bare prefix back as
# the "task". So:
#
#   * no title record yet, Claude still has a chance  -> emit {} and stay out of the way
#   * no title record and Claude has had its chance   -> synthesise a subject ourselves
#   * a title record exists                           -> prefix it, as before
#
# "Has had its chance" is measured in assistant turns, not prompts: the ai-title is written at the
# first prompt, ahead of the first assistant reply (transcript 66159310 has ai-title on line 20 and
# its first assistant record on line 21). Two turns gives a margin.
#
# CONTRACT: print valid JSON, always exit 0. A UserPromptSubmit hook's non-JSON stdout is injected
# into the conversation as context, and a non-zero exit blocks the prompt outright.
set -euo pipefail

# How many assistant turns to let pass before giving up on Claude naming the session itself.
TAKEOVER_AFTER_ASSISTANT_TURNS=2
# Longest synthesised subject, in characters, before the whole title is capped.
SYNTH_SUBJECT_MAX=64

# Bounded: the harness always pipes the payload and closes stdin, but a bare `cat` would hang
# forever if this is ever run by hand, and a stalled UserPromptSubmit hook stalls the prompt.
payload=$(timeout 2 cat || true)

jq_field() { printf '%s' "$payload" | jq -r "$1 // empty" 2>/dev/null || true; }
cwd=$(jq_field '.cwd')
transcript=$(jq_field '.transcript_path')
event=$(jq_field '.hook_event_name')
session=$(jq_field '.session_id')
[ -n "$event" ] || event=UserPromptSubmit
# The transcript is named <session-id>.jsonl, so it carries the id even when the payload does not.
if [ -z "$session" ] && [ -n "$transcript" ]; then
	session=${transcript##*/}
	session=${session%.jsonl}
fi

emit_nothing() {
	printf '{}\n'
	exit 0
}

# --- prefix: which checkout ------------------------------------------------------------------
# Same derivation as ~/bin/claude-sway-urgent:159-174, kept deliberately in sync.
# Sets $REPO_LABEL to "repo:branch", or leaves it empty when $1 is not inside a checkout.
REPO_LABEL=""
repo_label_for() {
	local dir=$1 top repo branch gitdir common mainroot
	REPO_LABEL=""
	[ -n "$dir" ] || return 0
	top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null || true)
	[ -n "$top" ] || return 0
	repo=${top##*/}
	branch=$(git -C "$top" branch --show-current 2>/dev/null || true)
	# In a linked worktree the per-worktree git dir differs from the shared common dir. The
	# toplevel is then the worktree dir, whose basename is the branch slug (native worktrees
	# live at <repo-root>/.claude/worktrees/<slug>) -- so take the repo name from the common dir
	# instead, or the title would name the branch twice and never the repo.
	gitdir=$(git -C "$top" rev-parse --absolute-git-dir 2>/dev/null || true)
	common=$(git -C "$top" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
	if [ -n "$gitdir" ] && [ "$gitdir" != "$common" ]; then
		mainroot=${common%/.git}
		repo=${mainroot##*/}
	fi
	REPO_LABEL="${repo}${branch:+:$branch}"
}

# The directory the session was LAUNCHED in, which survives a /cd. ~/.claude/sessions/<pid>.json
# is keyed by pid, so match on the session id inside. (Its `name` field is a different thing --
# an agents-view slug like `serge-1c` -- and is deliberately not used as a title source.)
launch_cwd() {
	local dir f
	dir=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/sessions
	[ -n "$session" ] && [ -d "$dir" ] || return 0
	f=$(grep -F -l -e "\"sessionId\":\"$session\"" "$dir"/*.json 2>/dev/null | head -1 || true)
	[ -n "$f" ] || return 0
	jq -r '.cwd // empty' "$f" 2>/dev/null || true
}

# Prefer the checkout we are standing in; a /cd into a non-repo (a review directory, /tmp) falls
# back to the one the session started in rather than replacing the repo with a stray basename --
# transcript 643f3fe8 recorded `peppy-crafting-lemur · opsmaster:master` from exactly that.
repo_label_for "$cwd"
prefix=$REPO_LABEL
if [ -z "$prefix" ]; then
	repo_label_for "$(launch_cwd)"
	prefix=$REPO_LABEL
fi
if [ -z "$prefix" ] && [ -n "$cwd" ]; then
	# Not a checkout either way: use the basename. $HOME is special-cased to the word "home"
	# rather than its basename "serge" (which reads as a person, not a place) -- and rather than
	# "~", which was tried first and is too small a glyph to register in a titlebar.
	if [ "$cwd" = "${HOME:-/nonexistent}" ]; then
		prefix="home"
	else
		prefix=${cwd##*/}
	fi
fi

# The strip below recognises a previously-applied prefix by it being a single space-free token, so
# a prefix containing a space would never be stripped and would accumulate. An empty one has
# nothing to say anyway. Either way, leave the title alone.
case $prefix in
'' | *' '*) emit_nothing ;;
esac

if [ -z "$transcript" ] || [ ! -f "$transcript" ]; then
	emit_nothing
fi

# --- base: what the task is ------------------------------------------------------------------
# Titles are appended as {"type":"ai-title","aiTitle":...} / {"type":"custom-title",
# "customTitle":...}. Scan the whole file rather than a tail window: ai-title records are written
# early and rarely, so a fixed tail would miss them in any long session.
#
# grep is only a prefilter -- it also matches lines that merely *quote* those strings (a
# tool_result from a session that greps its own transcript does exactly that), so jq re-checks
# the top-level .type before trusting the line. `fromjson?` swallows a torn or oversized line
# instead of aborting the stream and losing every record after it.
base=$( { grep -aE '"type": ?"(ai|custom)-title"' "$transcript" 2>/dev/null || true; } |
	jq -rR 'fromjson? | select(.type == "ai-title" or .type == "custom-title")
	        | .aiTitle // .customTitle // empty' 2>/dev/null |
	tail -n 1 || true)

# Strip our own prefix if this title has been through here before. `${base#* · }` alone is WRONG:
# its `*` matches spaces too, so an ai-title that genuinely contains " · " (say "foo bar · baz")
# would be cut down to "baz". Strip only when the part before the first " · " is a single
# space-free token -- which is exactly the shape this script emits and nothing else.
case $base in
*' · '*)
	lead=${base%%' · '*}
	case $lead in
	*' '*) ;;
	*) base=${base#* · } ;;
	esac
	;;
esac
base=$(printf '%s' "$base" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')

# What is left of a title the old unconditional version wrote is the bare prefix, so it carries no
# subject at all. Treating that as "no subject" rather than as text is what lets a session already
# stuck on `opsmaster:master · opsmaster:master` recover on its next prompt instead of staying
# nameless forever.
[ "$base" != "$prefix" ] || base=""

# Self-heal: a session already stuck (2026-08 defect, fixed below in the synthesis path but not
# retroactively) has a `custom-title` that is itself a raw harness record -- a wrapper tag pair, a
# `<local-command-caveat>`/`<local-command-stdout>` block, a `<task-notification>` -- verbatim.
# Requiring a *complete* closing tag is not enough: two live stuck titles were caught mid-tag by an
# earlier (since-shortened) prefix pushing the combined title over the 120-char cap, so what is
# actually stored is e.g. `<command-message>superpowers:brainstorming</command-message` with no
# final `>` -- the pair-match guard misses these. The opening tag alone is the reliable signal: it
# is always short enough (18-23 chars) to survive any truncation this script performs, complete or
# not, for every record type in the table (see ~/etc/docs/terminal.md). Same test as the forward
# skip logic above: a lowercase XML-ish tag at position 0. A stored title can only ever start this
# way by having been a raw harness record when written -- no code path, old or new, synthesises a
# subject that legitimately starts with one, so there is nothing here to false-positive on besides
# the same documented, accepted residual (a title that itself begins by typing a literal tag).
case $base in
'<'[a-z]*'>'*) base="" ;;
esac

# --- no subject yet: yield, or take over -------------------------------------------------------
if [ -z "$base" ]; then
	turns=$(grep -ac '"type":"assistant"' "$transcript" 2>/dev/null || true)
	[ -n "$turns" ] || turns=0
	# Still early -- writing anything here is what kills the ai-title (run C above).
	[ "$turns" -ge "$TAKEOVER_AFTER_ASSISTANT_TURNS" ] || emit_nothing

	# Claude is not going to name this session. Prefer the plan's own H1: every plan sampled has
	# a descriptive one, while the file name is a harness slug ("peppy-crafting-lemur").
	# <plan>.md.lock records `session: <uuid>`, which is the only session->plan mapping outside
	# the transcript.
	plandir=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plans
	lock=$(grep -F -l -e "session: $session" "$plandir"/*.md.lock 2>/dev/null | head -1 || true)
	# `[ -f ] && x=$(...)` would be WRONG under `set -e`: with no plan file the AND-list's own
	# status is 1 and the script would abort here, emitting nothing at all.
	plan=${lock%.lock}
	if [ -n "$lock" ] && [ -f "$plan" ]; then
		base=$(grep -am1 -e '^# ' "$plan" 2>/dev/null | sed -E 's/^#[[:space:]]*//' || true)
	fi

	# Otherwise the first thing that was asked. `last-prompt` records are unreliable (the first
	# one carries no lastPrompt field), so read the first real user message instead -- but the
	# same transcript slot also carries harness-generated pseudo-messages that are never a real
	# subject: a command wrapper (<command-message>, custom/skill commands), a *reversed* command
	# wrapper (<command-name> first -- every built-in: /clear, /compact, /plan, /model),
	# <local-command-caveat>, <local-command-stdout>, and <task-notification>. All six are
	# tag-prefixed at position 0; a typed prompt never is. A single `/plan open` alone emits three
	# of them (caveat, wrapper, stdout) under one prompt, so skipping just one type is not enough.
	# See ~/etc/docs/terminal.md and the plan this was implemented from for the full record table.
	#
	# `jq -c` (compact), not `jq -r`: wrapper content has real embedded newlines, and raw output
	# would merge separate candidates' text onto one line, breaking the one-line-per-candidate
	# invariant the selection loop below depends on. Compact JSON keeps each candidate's own
	# newlines as the harmless two-character escape `\n`.
	if [ -z "$base" ]; then
		winner=""
		while IFS= read -r enc; do
			case $enc in
			# The one wrapper shape worth extracting from -- see below.
			'"<command-message>'*) winner=$enc; break ;;
			# Any other tag-shaped record (built-in wrapper, caveat, stdout, task-notification,
			# or a future harness record type not yet seen) -- skip, keep scanning.
			'"<'[a-z]*'>'*) continue ;;
			# A genuine typed prompt.
			*) winner=$enc; break ;;
			esac
		done <<-CANDIDATES
		$( { grep -a -e '"type":"user","message":{"role":"user","content":"' "$transcript" 2>/dev/null || true; } |
			jq -c '.message.content
			       | if type == "string" then . else ([.[]? | select(.type == "text") | .text] | join(" ")) end
			       // empty' 2>/dev/null)
		CANDIDATES

		if [ -n "$winner" ]; then
			text=$(printf '%s\n' "$winner" | jq -r '.' 2>/dev/null | tr '\n' ' ')
			case $winner in
			'"<command-message>'*)
				# Subject is "command name (slash stripped) + args". Anchored with `^` and
				# `[^<]*` for the two non-user fields (Claude Code's own command slug, never
				# contains `<`) so that a `<command-args>` value quoting a fake
				# `<command-name>...</command-name>` -- user-controlled text -- can't be mistaken
				# for the real structural tag. The args capture stays greedy `.*`: real args can
				# legitimately contain a literal `<` (comparisons, redirection examples, generic
				# types), and `[^<]*` would silently truncate at the first one. Greedy is safe
				# here because args is the last field and everything before it is anchored, so
				# there is exactly one place it can structurally start.
				base=$(printf '%s' "$text" |
					sed -n 's/^<command-message>[^<]*<\/command-message>[[:space:]]*<command-name>\/\?\([^<]*\)<\/command-name>.*/\1/p')
				cargs=$(printf '%s' "$text" |
					sed -n 's/^<command-message>[^<]*<\/command-message>[[:space:]]*<command-name>\/\?[^<]*<\/command-name>[[:space:]]*<command-args>\(.*\)<\/command-args>.*/\1/p')
				[ -z "$cargs" ] || base="$base $cargs"
				;;
			*) base=$text ;;
			esac
		fi
	fi

	# One line, no leading slash-command, no surrounding blanks, bounded length.
	base=$(printf '%s' "$base" | tr '\n\t' '  ' |
		sed -E 's/^\/[a-zA-Z0-9:_-]+ *//; s/^[[:space:]]+//; s/[[:space:]]+$//')
	if [ "${#base}" -gt "$SYNTH_SUBJECT_MAX" ]; then
		base=${base:0:$((SYNTH_SUBJECT_MAX - 1))}…
	fi
	# A synthesis that collapsed to the prefix (or to nothing) must not reintroduce the defect.
	[ "$base" != "$prefix" ] || base=""
	# Same markup guard as above: with the selection loop in place nothing tag-shaped should reach
	# here from a fresh synthesis, but keep the backstop -- cheap, and a second line of defence.
	case $base in
	'<'[a-z]*'>'*) base="" ;;
	esac
fi

title="$prefix${base:+ · $base}"

# Cap: a sway titlebar is finite and Claude Code truncates long titles itself. Cut on characters,
# not bytes -- `·` and any non-ASCII in the task name are multibyte.
if [ "${#title}" -gt 120 ]; then
	title=${title:0:119}…
fi

jq -cn --arg e "$event" --arg t "$title" \
	'{hookSpecificOutput: {hookEventName: $e, sessionTitle: $t}}' 2>/dev/null ||
	printf '{}\n'
