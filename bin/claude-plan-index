#!/usr/bin/env bash
# Maintain ~/.claude/plans/INDEX.md, a one-line-per-plan table of what each plan file is about.
#
# Plan file names are harness slugs derived from the first prompt plus a random word pair --
# `peppy-crafting-lemur.md`, `have-a-look-at-velvet-cake.md`. With 219 of them, none of that is
# searchable. Every plan's H1 *is* descriptive, so the index carries the H1, the checkout the plan
# was written for, and the modification date.
#
# Two modes:
#
#   claude-plan-index              read a Stop-hook payload on stdin and upsert this session's plan
#   claude-plan-index --backfill   scan every existing plan and insert any row that is missing
#
# Renaming the plan files themselves was considered and rejected: the harness records the path in
# both the transcript (`"planFilePath"`) and `<plan>.md.lock`, so a rename strands a live session.
#
# CONTRACT (hook mode): print nothing on stdout, always exit 0. A Stop hook's stdout is shown to
# the user, and a non-zero exit is reported as a hook failure.
set -euo pipefail

PLANDIR=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plans
INDEX=$PLANDIR/INDEX.md
SESSIONS=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/sessions

# Table header, rewritten on every save so a hand-edited or truncated file self-repairs.
header() {
	printf '# Plan index\n\n'
	# shellcheck disable=SC2016  # backticks are markdown here, not command substitution
	printf 'Generated by `~/bin/claude-plan-index` (Stop hook + `--backfill`). Newest first.\n'
	printf 'Plan file names are harness slugs; the Subject column is each plan H1.\n\n'
	printf '| Updated | Plan | Where | Subject |\n'
	printf '|---|---|---|---|\n'
}

# First `# ` heading in the first 30 lines, with table-breaking pipes neutralised.
plan_h1() {
	local f=$1 line n=0
	while [ $n -lt 30 ] && IFS= read -r line; do
		n=$((n + 1))
		case $line in
		'# '*)
			printf '%s' "${line#\# }" | sed -e 's/|/\\|/g'
			return 0
			;;
		esac
	done <"$f"
}

# "repo:branch" for a directory, matching ~/bin/claude-session-title's derivation: a linked
# worktree takes its repo name from the git COMMON dir, because the toplevel basename there is the
# branch slug, not the repo.
repo_label_for() {
	local dir=$1 top repo branch gitdir common mainroot
	[ -n "$dir" ] || return 0
	top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null || true)
	[ -n "$top" ] || return 0
	repo=${top##*/}
	branch=$(git -C "$top" branch --show-current 2>/dev/null || true)
	gitdir=$(git -C "$top" rev-parse --absolute-git-dir 2>/dev/null || true)
	common=$(git -C "$top" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
	if [ -n "$gitdir" ] && [ "$gitdir" != "$common" ]; then
		mainroot=${common%/.git}
		repo=${mainroot##*/}
	fi
	printf '%s' "${repo}${branch:+:$branch}"
}

# Replace the row for $1 (a plan basename) with $2, or insert it. Idempotent by construction: the
# old row is filtered out by key before the new one is added, so running twice with unchanged
# inputs yields a byte-identical file. Rows are sorted descending, which works on the raw line
# because every row starts with `| YYYY-MM-DD HH:MM`.
save_row() {
	local key=$1 row=$2 tmp body
	tmp=$(mktemp "$PLANDIR/.INDEX.md.XXXXXX")
	body=""
	if [ -f "$INDEX" ]; then
		# Rows only: anything that is not a table row is regenerated by header().
		# The key must match how the cell is actually written -- `| [name](name) |`, not
		# `| name |`. Matching the bare name filtered nothing and every run appended a
		# duplicate row instead of replacing one.
		body=$(grep -E '^\| [0-9]{4}-' -- "$INDEX" 2>/dev/null | grep -vF -e "| [$key](" || true)
	fi
	{
		header
		{
			[ -n "$body" ] && printf '%s\n' "$body"
			printf '%s\n' "$row"
		} | sort -r
	} >"$tmp"
	mv -- "$tmp" "$INDEX"
}

row_for() { # <plan-path> <where>
	local plan=$1 where=$2 when h1
	when=$(date -r "$plan" '+%Y-%m-%d %H:%M' 2>/dev/null || true)
	[ -n "$when" ] || return 1
	h1=$(plan_h1 "$plan" || true)
	printf '| %s | [%s](%s) | %s | %s |' \
		"$when" "${plan##*/}" "${plan##*/}" "$where" "${h1:-—}"
}

# --- backfill ----------------------------------------------------------------------------------
if [ "${1:-}" = "--backfill" ]; then
	[ -d "$PLANDIR" ] || exit 0
	shopt -s nullglob
	n=0
	for plan in "$PLANDIR"/*.md; do
		[ "${plan##*/}" != "INDEX.md" ] || continue
		# Existing rows are left alone: they may carry a `Where` that cannot be recovered
		# from the file, since the session that wrote the plan is long gone.
		if [ -f "$INDEX" ] && grep -qF -e "| [${plan##*/}](" -- "$INDEX"; then
			continue
		fi
		if row=$(row_for "$plan" "—"); then
			save_row "${plan##*/}" "$row"
			n=$((n + 1))
		fi
	done
	shopt -u nullglob
	printf 'indexed %d new plan(s) into %s\n' "$n" "$INDEX"
	exit 0
fi

# --- hook mode ---------------------------------------------------------------------------------
payload=$(timeout 2 cat || true)
jq_field() { printf '%s' "$payload" | jq -r "$1 // empty" 2>/dev/null || true; }
session=$(jq_field '.session_id')
transcript=$(jq_field '.transcript_path')
cwd=$(jq_field '.cwd')
if [ -z "$session" ] && [ -n "$transcript" ]; then
	session=${transcript##*/}
	session=${session%.jsonl}
fi
[ -n "$session" ] || exit 0

# Resolving session -> plan, cheapest first:
#   1. <plan>.md.lock's `session: <uuid>` -- authoritative, but only exists while plan mode is
#      actually held, so it is gone the moment ExitPlanMode runs;
#   2. the transcript's `"planFilePath"`, which is durable. Scanned from the tail because a long
#      session's transcript reaches tens of megabytes and the record is rewritten on every plan
#      edit, so the last couple of megabytes effectively always contain it.
#   0. the pointer this hook itself wrote on an earlier turn, so an established session never
#      re-scans. This hook fires on every assistant response, in every session.
plan=""
bysession=$PLANDIR/.by-session
if [ -r "$bysession/$session" ]; then
	read -r plan <"$bysession/$session" || plan=""
	[ -f "$plan" ] || plan=""
fi
lock=""
if [ -z "$plan" ]; then
	lock=$(grep -F -l -e "session: $session" "$PLANDIR"/*.md.lock 2>/dev/null | head -1 || true)
fi
if [ -n "$plan" ]; then
	: # already resolved from the pointer
elif [ -n "$lock" ]; then
	plan=${lock%.lock}
elif [ -n "$transcript" ] && [ -f "$transcript" ]; then
	plan=$(tail -c 2000000 -- "$transcript" 2>/dev/null |
		grep -aoE '"planFilePath":"[^"]*"' | tail -1 |
		sed -E 's/^"planFilePath":"//; s/"$//' || true)
fi
[ -n "$plan" ] && [ -f "$plan" ] || exit 0

# O(1) session -> plan pointer for the HUD wrapper, which repaints far too often to scan either
# the lock files or a multi-megabyte transcript.
mkdir -p -- "$bysession"
printf '%s\n' "$plan" >"$bysession/$session"

where=$(repo_label_for "$cwd" || true)
if [ -z "$where" ] && [ -d "$SESSIONS" ]; then
	# A /cd out of the checkout: fall back to where the session was launched.
	sf=$(grep -F -l -e "\"sessionId\":\"$session\"" "$SESSIONS"/*.json 2>/dev/null | head -1 || true)
	# An `[ -n ] && x=$(...)` one-liner would abort the script under `set -e` whenever $sf is
	# empty, because the AND-list's own status is then 1 and it is the last command in this block.
	if [ -n "$sf" ]; then
		where=$(repo_label_for "$(jq -r '.cwd // empty' "$sf" 2>/dev/null || true)" || true)
	fi
fi

if row=$(row_for "$plan" "${where:-—}"); then
	save_row "${plan##*/}" "$row"
fi
exit 0
