#!/usr/bin/env bash
# Catch whatever spawns the unexplained cwd=/tmp Claude Code sessions.
#
# Symptom: ~/.claude/projects/-tmp is recreated and a ~/.claude/session-env/<uuid> appears,
# ~0.4s apart, with no transcript and no ~/.claude/sessions/<pid>.json. Observed 2026-07-27
# 19:02, 19:47 and 2026-07-28 10:06 -- irregular. Those sessions inherit ~/.claude/settings.json
# and so fire the OSD hooks, which is how they were noticed.
#
# inotifywait reports no creator pid, so this snapshots every claude process (with cwd) the
# instant the directory appears. Measured trigger latency 1.7ms; it caught a 0.85s process in
# testing, but a spawner that exits faster than the snapshot is still missed.
set -uo pipefail
out=${XDG_STATE_HOME:-$HOME/.local/state}/tmp-session-catch.log
exec inotifywait -m -e create --format '%w%f' \
	"$HOME/.claude/projects" "$HOME/.claude/session-env" 2>/dev/null |
while read -r p; do
	case "$p" in
		*/projects/-tmp | */session-env/*)
			{
				date -Is
				echo "TRIGGER $p"
				ps -eo pid,ppid,lstart,args --sort=start_time | grep -a '[c]laude\|[n]ah\|[c]odex'
				for d in /proc/[0-9]*; do
					case "$(tr '\0' ' ' < "$d/cmdline" 2>/dev/null)" in
						*claude*) printf '%s cwd=%s\n' "${d#/proc/}" "$(readlink "$d/cwd" 2>/dev/null)" ;;
					esac
				done
				echo
			} >> "$out"
			;;
	esac
done
