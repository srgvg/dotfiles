#!/usr/bin/env bash

set -o nounset
set -o errexit
set -o pipefail

# shellcheck disable=SC1090
source "$HOME/bin/common.bash"
# shellcheck source=lib/rename-safe.bash
source "$(dirname -- "${BASH_SOURCE[0]}")/lib/rename-safe.bash"

usage() {
    cat >&2 <<'EOF'
Usage: rename2timestamp [-c|--copy] [1|2|01|02] filenames...
  -c, --copy  Copy instead of move.
  1           Prepend timestamp: timestamp-filename.ext.
  2           Replace name: timestamp.ext.
  01, 02      Preview only; omitted action defaults to 01.
Rejects existing destinations and duplicate names before changing any file.
Unchanged names are no-ops. Existing files are never overwritten.
EOF
}

operation="mv"
preview=true
action=1
if [[ "${1:-}" == -c || "${1:-}" == --copy ]]; then
    operation="cp"
    shift
fi
case "${1:-}" in
    1|2) action=$1; preview=false; shift ;;
    0|01) shift ;;
    02) action=2; shift ;;
esac
if (( $# == 0 )); then
    usage
    exit 1
fi

declare -a sources=() destinations=()
for file in "$@"; do
    if [[ ! -r "$file" ]]; then
        printf 'Cannot read %s\n' "$file" >&2
        exit 1
    fi
    rename_path "$file"
    filepathname=$RENAME_PATH
    filename=${filepathname##*/}
    filepath=${filepathname%/*}
    filenamebase=${filename%.*}
    filenamext=${filename##*.}
    filepoch=$(stat -c %Y -- "$filepathname")
    filets=$(date -d "@$filepoch" +%Y%m%d%H%M%S)
    if [[ "$action" == 1 ]]; then
        newpathname="${filepath}/${filets}-${filenamebase}.${filenamext}"
    else
        newpathname="${filepath}/${filets}.${filenamext}"
    fi
    sources+=("$filepathname")
    destinations+=("$newpathname")
done

# Keep the existing DEBUG=3 preview behavior.
if ifdebug3; then
    preview=true
fi
rename_batch "$operation" "$preview" sources destinations
