#!/usr/bin/env python3
"""Read-only local Git graph summary. No fetch, authority, readiness or writes."""
import argparse
import datetime
import json
import os
from pathlib import Path
import subprocess
import sys
import importlib.machinery
import importlib.util

_loader = importlib.machinery.SourceFileLoader('safe_git_preflight', str(Path(__file__).with_name('git-preflight')))
_spec = importlib.util.spec_from_loader(_loader.name, _loader)
safe = importlib.util.module_from_spec(_spec)
_loader.exec_module(safe)


def inspect(repo, target, remote_tip=None, warn_at=20):
    env = safe.environment()
    # Shared environment guard precedes every Git call, including ancestry.
    repo = Path(repo).resolve(strict=True)

    def run_git(*args, check=True):
        return subprocess.run(['git', '-C', str(repo), *args], env=env,
                              capture_output=True, text=True, check=check)

    def git(*args):
        return run_git(*args).stdout.strip()

    def context():
        return tuple(Path(git('rev-parse', *args)).resolve() for args in (
            ('--show-toplevel',), ('--absolute-git-dir',),
            ('--path-format=absolute', '--git-common-dir')))

    # .git may be a normal directory or a legitimate linked-worktree gitfile.
    # Do not accidentally discover a parent repository or a redirected worktree.
    selected = context()
    if selected[0] != repo:
        raise safe.Refusal('REPOSITORY_MISMATCH: --repo must name the selected worktree root')

    def oid(ref):
        safe.atom(ref)
        return safe.oid(git('rev-parse', '--verify', '--end-of-options', ref+'^{commit}'))

    def count(*args):
        return int(git('rev-list', '--count', *args))

    if git('rev-parse', '--is-shallow-repository') != 'false':
        raise safe.Refusal('INCOMPLETE_HISTORY: shallow checkout; counts unknown')
    if git('config', '--get', 'core.repositoryformatversion') not in ('0', '1'):
        raise safe.Refusal('unsupported repository format')
    head, base = oid('HEAD'), oid(target)
    remote = oid(remote_tip) if remote_tip else None
    branch = safe.atom(git('rev-parse', '--abbrev-ref', 'HEAD'))
    dirty = git('status', '--porcelain', '--untracked-files=normal')
    common = git('merge-base', '--all', head, base).splitlines()
    if len(common) != 1:
        raise safe.Refusal('AMBIGUOUS_MERGE_BASE: counts require a single common base')
    total = count(head, '--not', base)
    merges = count('--min-parents=2', head, '--not', base)
    # Only an observed ancestor is a usable boundary for unpublished work.
    unpushed = None
    if remote:
        ancestor = run_git('merge-base', '--is-ancestor', remote, head, check=False)
        if ancestor.returncode not in (0, 1):
            raise safe.Refusal('cannot establish observed remote ancestry')
        if ancestor.returncode == 0:
            unpushed = count(head, '--not', remote, base)
    result = dict(head=head, target=base, target_ref=target, branch=branch,
                  tree=git('rev-parse', head+'^{tree}'), merge_base=common[0],
                  observed_remote_tip=remote, remote_freshness='caller observation; no network read',
                  changeset_commits=total, changeset_merge_commits=merges,
                  changeset_non_merge_commits=total-merges,
                  target_only_commits=count(base, '--not', head),
                  unpublished_changeset_commits=unpushed,
                  repair_commits='not inferred; use recorded candidate/operation relationships',
                  dirty=bool(dirty), warning_threshold=warn_at,
                  warnings=['REVIEW_COMMIT_GROWTH'] if total >= warn_at else [],
                  authority=False, readiness='not evaluated',
                  observed_at=datetime.datetime.now(datetime.timezone.utc).isoformat())
    # Bounded local start/end consistency. Never label a mixed read a snapshot.
    if context() != selected or (head, base, remote, branch, dirty) != (
            oid('HEAD'), oid(target), oid(remote_tip) if remote_tip else None,
            git('rev-parse', '--abbrev-ref', 'HEAD'),
            git('status', '--porcelain', '--untracked-files=normal')):
        raise safe.Refusal('CONTEXT_MOVED: retry a read; no successful snapshot')
    return result


def main():
    parser = safe.Parser(description=__doc__)
    parser.add_argument('--repo', required=True, type=Path, help='explicit worktree root; inherited Git context overrides refuse')
    parser.add_argument('--target', required=True, help='explicit local target ref or observed full OID')
    parser.add_argument('--remote-tip', help='explicit already-observed remote branch ref/OID, not a freshness assertion')
    parser.add_argument('--warn-at', type=int, default=20, help='advisory only; never grants rewrite permission')
    try:
        args = parser.parse_args()
        if args.warn_at < 1:
            raise safe.Refusal('warning threshold must be positive')
        print(json.dumps(inspect(args.repo, args.target, args.remote_tip, args.warn_at), sort_keys=True))
    except (ValueError, OSError, subprocess.SubprocessError) as exc:
        print(json.dumps(dict(error=safe.error(exc), authority=False, readiness='unknown')), file=sys.stderr)
        return 2
    return 0


if __name__ == '__main__':
    sys.exit(main())
