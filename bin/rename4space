#!/usr/bin/env bash

set -o nounset
set -o errexit
set -o pipefail

# shellcheck disable=SC1090
source "$HOME/bin/common.bash"
# shellcheck source=lib/rename-safe.bash
source "$(dirname -- "${BASH_SOURCE[0]}")/lib/rename-safe.bash"

# Usage: rename4space [do] filenames...
# Defaults to preview. Preflights the whole batch: existing or duplicate
# destinations fail before any rename, unchanged names are no-ops. Never clobbers.
preview=true
if [[ "${1:-}" == "do" ]]; then
    preview=false
    shift
fi

declare -a sources=() destinations=()
for file in "$@"; do
    if [[ ! -f "$file" ]]; then
        printf 'File does not exist: %s\n' "$file" >&2
        exit 1
    fi
    rename_path "$file"
    file=$RENAME_PATH
    name=${file##*/}
    path=${file%/*}
    sources+=("$file")
    destinations+=("$path/${name// /_}")
done
rename_batch mv "$preview" sources destinations
