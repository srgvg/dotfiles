{
    "layer": "top",
    "position": "top",
    "height": 42,
    "output": ["DP-5"],
    "spacing": 12,
    "mode": "dock",

    "modules-left": ["sway/workspaces", "sway/mode", "sway/scratchpad", "sway/window"],
    "modules-center": ["idle_inhibitor", "custom/media"],
    "modules-right": ["pulseaudio", "bluetooth", "network", "temperature", "cpu", "memory", "disk", "disk#2", "tray", "custom/notification", "clock"],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{name}"
    },
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "sway/window": {
        "tooltip": true,
        "icon": true,
        "icon-size": 24,
        "all-outputs": true,
        "max-length": 300
    },
    "sway/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", ""],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰅶",
            "deactivated": "󰾪"
        },
        "tooltip-format-activated": "Idle inhibitor: ON - screen will stay awake",
        "tooltip-format-deactivated": "Idle inhibitor: OFF - screen will sleep normally"
    },
    "tray": {
        "icon-size": 28,
        "spacing": 16,
        "show-passive-items": true,
        "reverse-direction": true
    },
    "clock": {
        "timezone": "Europe/Brussels",
        "format": "<span size='large'><b>󰥔 {:%A %d %B %Y   %H:%M:%S}</b></span>",
        // no format-alt, so left-click is free for the swaync panel.
        "on-click": "swaync-client -t -sw",
        // Calendar tooltip disabled 2026-08-03: it pops on hover and covers the swaync
        // control center, which opens in the same top-right corner. The "calendar" block
        // and "tooltip-format" are removed rather than left dead -- waybar renders the
        // calendar whenever "calendar" is present and tooltips are on.
        "tooltip": false,
        "interval": 1
    },
    "cpu": {
        "format": "󰍛 {usage}%",
        "tooltip": true,
        "interval": 2,
        "on-click": "swaymsg exec 'foot -e htop'"
    },
    "memory": {
        "format": "󰘚 {percentage}%",
        "format-alt": "󰘚 {used:0.1f}G / {total:0.1f}G",
        "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G ({percentage}%)\nSwap: {swapUsed:0.1f}G / {swapTotal:0.1f}G ({swapPercentage}%)",
        "interval": 5,
        "on-click": "swaymsg exec 'foot -e htop'"
    },
    "disk": {
        "format": "󰋊 {percentage_used}%",
        "format-alt": "󰋊 {used} / {total}",
        "tooltip-format": "{path}: {used} / {total} ({percentage_used}%)",
        "path": "/",
        "interval": 30
    },
    "disk#2": {
        "format": "󰋊 {percentage_used}%",
        "format-alt": "󰋊 {used} / {total}",
        "tooltip-format": "{path}: {used} / {total} ({percentage_used}%)",
        "path": "/home",
        "interval": 30
    },
    "temperature": {
        "critical-threshold": 80,
        "format": "{temperatureC}°C {icon}",
        "format-critical": "<span color='#f53c3c'>{temperatureC}°C {icon}</span>",
        "format-icons": ["󱃃", "󰔏", "󱃂"],
        "tooltip-format": "Temperature: {temperatureC}°C"
    },
    "network": {
        "format-wifi": "󰖩 {essid} ({signalStrength}%)",
        "format-ethernet": "󰈀 {ipaddr}/{cidr}",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}\nGateway: {gwaddr}\n↑ {bandwidthUpBytes} ↓ {bandwidthDownBytes}",
        "format-linked": "󰈀 {ifname} (No IP)",
        "format-disconnected": "󰖪 Disconnected",
        "format-alt": "󰈀 ↑{bandwidthUpBytes} ↓{bandwidthDownBytes}",
        "interval": 5
    },
    "bluetooth": {
        "format": "󰂯 {status}",
        "format-connected": "󰂱 {device_alias}",
        "format-connected-battery": "󰂱 {device_alias} {device_battery_percentage}%",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "tooltip-format": "{controller_alias}\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\n{num_connections} connected\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias} ({device_battery_percentage}%)",
        "on-click": "blueman-manager"
    },
    "pulseaudio": {
        "format": "{icon} {volume}% {format_source}",
        "format-bluetooth": "󰂰 {volume}% {format_source}",
        "format-bluetooth-muted": "󰂲 {format_source}",
        "format-muted": "󰖁 {format_source}",
        "format-source": "󰍬 {volume}%",
        "format-source-muted": "󰍭",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋋",
            "headset": "󰋎",
            "phone": "󰏲",
            "portable": "󰏲",
            "car": "󰄋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
    },
    "custom/media": {
        "format": "<b>{icon} {}</b>",
        "max-length": 100,
        "format-icons": {
            "spotify": "󰓇",
            "default": "󰎆"
        },
        "escape": true,
        "exec": "$HOME/bin/i3pystatus-commands now_playing 2> /dev/null | tr '[:lower:]' '[:upper:]'",
        "interval": 5
    },
    // swaync unread count + DND state (2026-08-03). `swaync-client -swb` is a long-running
    // subscription that streams waybar-shaped JSON -- no "interval", waybar keeps the pipe open.
    // The dot in the icon means unread; the crossed bell means DND is on.
    "custom/notification": {
        "tooltip": false,
        "format": "{icon} {}",
        "format-icons": {
            "notification": "󰂚<span foreground='red'><sup></sup></span>",
            "none": "󰂚",
            "dnd-notification": "󰂛<span foreground='red'><sup></sup></span>",
            "dnd-none": "󰂛",
            "inhibited-notification": "󰂚<span foreground='red'><sup></sup></span>",
            "inhibited-none": "󰂚",
            "dnd-inhibited-notification": "󰂛<span foreground='red'><sup></sup></span>",
            "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    }
}
