[Unit]
Description=update-tools (mise + shell-init caches + completions)
Documentation=file:%h/etc/docs/shell-setup.md

[Service]
Type=oneshot
# Same order as the interactive PATH (~/.bashrc.d/2-path.bash, z70_path.bash), plus mise shims.
Environment=PATH=%h/.local/share/mise/shims:%h/.atuin/bin:%h/bin:%h/bins:%h/binc:%h/bin2:%h/.local/lib/npm/bin:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:%h/.local/bin:%h/.krew/bin
# cronjobs.sh keeps its own per-run logging under ~/logs/cronjobs/.
ExecStart=%h/bin/cronjobs.sh update-tools
