set $primary DP-4
set $panel DP-7
set $tv DP-5

# https://major.io/2022/05/24/sway-reload-causes-a-firefox-crash/
# swaymsg -t get_inputs -r | jq -r '.[].identifier' | grep -i keyboard
# Universal keyboard settings (applies to all keyboards)
input "type:keyboard" {
	xkb_layout "us"
	xkb_variant "euro"
	xkb_model "pc105"
	xkb_options "compose:caps,lv3:ralt_switch,eurosign:e,nbsp:level3n"
	xkb_capslock "disabled"
	xkb_numlock "enabled"
}
input "1386:965:Wacom_Intuos_BT_S_Pad" {
    map_to_output $primary
    tool_mode pen relative
}
input "1386:965:Wacom_Intuos_BT_S_Pen" {
    map_to_output $primary
    tool_mode pen relative
    pointer_accel 1
    accel_profile adaptive
}

output $primary {
    enable
    position 0 0
    mode 7680x2160
    scale 1.5
    dpms on
    max_render_time off
}
output $panel {
    enable
    # 60 Hz: the 120 Hz mode made sway's backend commit fail (2026-11-16), leaving the panel black
    position 0 1440
    resolution 2560x1600@59.972Hz
    scale 2
    dpms on
    #transform 270
}
output $tv {
    enable
    position 0 2500
    resolution 1920x1080
    scale 1
    #dpms on
}

seat seat0 keyboard_grouping smart

## Automatically putting workspaces on specific screens
workspace 0     output $panel
workspace 1     output $primary
workspace 2     output $primary
